<?xml version="1.0" encoding="utf-8"?>
<!-- Jarvis-style button: dark card with a thin outline, a little lighter while pressed -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <inset android:insetTop="3dp" android:insetBottom="3dp" android:insetLeft="2dp" android:insetRight="2dp">
            <shape android:shape="rectangle">
                <solid android:color="#141422" />
                <stroke android:width="1dp" android:color="@color/outline" />
                <corners android:radius="12dp" />
            </shape>
        </inset>
    </item>
    <item android:state_pressed="true">
        <inset android:insetTop="3dp" android:insetBottom="3dp" android:insetLeft="2dp" android:insetRight="2dp">
            <shape android:shape="rectangle">
                <solid android:color="@color/button_pressed" />
                <stroke android:width="1dp" android:color="@color/accent" />
                <corners android:radius="12dp" />
            </shape>
        </inset>
    </item>
    <item>
        <inset android:insetTop="3dp" android:insetBottom="3dp" android:insetLeft="2dp" android:insetRight="2dp">
            <shape android:shape="rectangle">
                <solid android:color="@color/button" />
                <stroke android:width="1dp" android:color="@color/outline" />
                <corners android:radius="12dp" />
            </shape>
        </inset>
    </item>
</selector>
