<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pageBoard"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="12dp">

    <TextView
        android:id="@+id/boardInfo"
        style="@style/Card"
        android:lineSpacingExtra="2dp"
        android:text="@string/board_info_none" />

    <LinearLayout style="@style/ButtonRow">

        <Button
            android:id="@+id/btnMute"
            style="@style/Quick"
            android:text="@string/q_mute" />

        <Button
            android:id="@+id/btnSleep"
            style="@style/Quick"
            android:text="@string/q_sleep" />

        <Button
            android:id="@+id/btnWake"
            style="@style/Quick"
            android:text="@string/q_wake" />
    </LinearLayout>

    <LinearLayout style="@style/ButtonRow">

        <Button
            android:id="@+id/btnRetry"
            style="@style/Quick"
            android:text="@string/q_retry" />

        <Button
            android:id="@+id/btnNew"
            style="@style/Quick"
            android:text="@string/q_new" />

        <Button
            android:id="@+id/btnReboot"
            style="@style/Quick"
            android:text="@string/q_reboot" />
    </LinearLayout>

    <TextView
        style="@style/Section"
        android:layout_marginTop="12dp"
        android:text="@string/chat_title" />

    <ListView
        android:id="@+id/chatList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="6dp"
        android:stackFromBottom="true" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingVertical="6dp">

        <EditText
            android:id="@+id/chatInput"
            android:importantForAutofill="no"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/chat_hint"
            android:imeOptions="actionSend"
            android:inputType="text" />

        <Button
            android:id="@+id/chatSend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chat_send"
            android:textAllCaps="false" />
    </LinearLayout>
</LinearLayout>
