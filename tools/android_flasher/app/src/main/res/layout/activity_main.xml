<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- our own title bar: with edge to edge (Android 15) it pads itself below the status bar -->
    <TextView
        android:id="@+id/appTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:text="@string/app_name"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- the console link: status + connect -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp">

        <TextView
            android:id="@+id/linkStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/card"
            android:padding="8dp"
            android:textSize="13sp" />

        <Button
            android:id="@+id/linkButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/link_connect"
            android:textAllCaps="false" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <include layout="@layout/page_board" />

        <include layout="@layout/page_log" />

        <ScrollView
            android:id="@+id/pageSettings"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/settingsBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingBottom="24dp" />
        </ScrollView>

        <ScrollView
            android:id="@+id/pageNav"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/navBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingBottom="24dp" />
        </ScrollView>

        <include layout="@layout/page_flash" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/tabBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/primary_dark"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tabBoard"
            style="@style/Tab"
            android:text="@string/tab_board" />

        <TextView
            android:id="@+id/tabLog"
            style="@style/Tab"
            android:text="@string/tab_log" />

        <TextView
            android:id="@+id/tabSettings"
            style="@style/Tab"
            android:text="@string/tab_settings" />

        <TextView
            android:id="@+id/tabNav"
            style="@style/Tab"
            android:text="@string/tab_nav" />

        <TextView
            android:id="@+id/tabFlash"
            style="@style/Tab"
            android:text="@string/tab_flash" />
    </LinearLayout>
</LinearLayout>
